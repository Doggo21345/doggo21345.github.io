---
// A drawn planet: shaded sphere, surface bands, optional ring. Color comes from the mission.
interface Props {
  id: string;
  color: string;
  rings?: boolean;
  size?: number;
  class?: string;
}
const { id, color, rings = false, size = 200, class: cls = '' } = Astro.props;
const g = `pl-${id}`;
---

<svg class={`planet ${cls}`} width={size} height={size} viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <radialGradient id={`${g}-body`} cx="35%" cy="32%" r="75%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
      <stop offset="18%" stop-color={color} />
      <stop offset="75%" stop-color={color} stop-opacity="0.55" />
      <stop offset="100%" stop-color="#000" />
    </radialGradient>
    <radialGradient id={`${g}-glow`} cx="50%" cy="50%" r="50%">
      <stop offset="60%" stop-color={color} stop-opacity="0.45" />
      <stop offset="100%" stop-color={color} stop-opacity="0" />
    </radialGradient>
    <clipPath id={`${g}-clip`}><circle cx="100" cy="100" r="60" /></clipPath>
  </defs>

  <circle cx="100" cy="100" r="92" fill={`url(#${g}-glow)`} />
  {rings && (
    <ellipse cx="100" cy="100" rx="95" ry="22" fill="none" stroke={color} stroke-opacity="0.5" stroke-width="5"
      transform="rotate(-18 100 100)" />
  )}
  <circle cx="100" cy="100" r="60" fill={`url(#${g}-body)`} />
  <g clip-path={`url(#${g}-clip)`} opacity="0.22">
    <path d="M30 80 Q100 62 170 82" stroke="#000" stroke-width="7" fill="none" />
    <path d="M30 108 Q100 92 170 112" stroke="#fff" stroke-width="4" fill="none" />
    <path d="M30 132 Q100 120 170 138" stroke="#000" stroke-width="9" fill="none" />
  </g>
  {rings && (
    <path d="M5 100 A95 22 0 0 0 195 100" fill="none" stroke={color} stroke-opacity="0.85" stroke-width="5"
      transform="rotate(-18 100 100)" />
  )}
</svg>
