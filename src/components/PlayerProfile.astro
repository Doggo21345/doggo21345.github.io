---
import { playerProfile } from '../data/profile';
---

<section id="player">
  <div class="wrap">
    <h2 class="p-heading">Player Profile</h2>

    <div class="holo pitch reveal">
      <p class="me-label">Next destination · Media &amp; Gaming</p>
      {playerProfile.pitch.map((p) => <p class="line">{p}</p>)}
    </div>

    <p class="me-label hof">Hall of fame · All-time favorite games</p>
    <div class="games">
      {playerProfile.games.map((g, i) => (
        <article class={`game ${g.style} reveal`} style={`--i:${i}`}>
          <span class="slot">{String(i + 1).padStart(2, '0')}</span>
          {g.name ? (
            <>
              <h3>{g.name}</h3>
              <p class="studio">{g.studio}</p>
              <p class="why">{g.line}</p>
            </>
          ) : (
            <>
              <h3>???</h3>
              <p class="studio">Slot locked</p>
              <p class="why">Third pick coming soon.</p>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pitch { padding: 2rem 2.25rem; max-width: 820px; }
  .line { font-family: var(--font-body); font-size: 1.1rem; margin: 0.9rem 0 0; }
  .line:first-of-type { font-family: var(--font-me); font-weight: 700; font-size: 1.5rem; line-height: 1.25; }

  .hof { margin-top: 4rem; }
  .games {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  .game {
    position: relative;
    min-height: 300px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    transition: transform 0.2s;
  }
  .game:hover { transform: translateY(-6px); }
  .slot {
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    font-family: var(--font-p);
    font-size: 4.5rem;
    line-height: 1;
    opacity: 0.25;
  }
  h3 { margin: 0; line-height: 1; }
  .studio { margin: 0.4rem 0 0.9rem; font-size: 0.8rem; letter-spacing: 0.25em; text-transform: uppercase; opacity: 0.75; }
  .why { margin: 0; font-size: 0.95rem; }

  /* Mass Effect card: dark, blue holo glow, orange accent stripe */
  .me {
    background:
      radial-gradient(circle at 80% 20%, rgba(79, 195, 255, 0.35), transparent 55%),
      linear-gradient(160deg, #0b1a2e, #04070d);
    border: 1px solid #4fc3ff;
    box-shadow: 0 0 24px rgba(79, 195, 255, 0.2);
    clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 26px 100%, 0 calc(100% - 26px));
    padding-right: 3.25rem;
  }
  .me::before {
    content: '';
    position: absolute;
    top: 0;
    right: 1.25rem;
    width: 12px;
    height: 100%;
    background: linear-gradient(#ff5a1f, #ff5a1f 33%, #fff 33%, #fff 40%, #ff5a1f 40%);
    opacity: 0.85;
  }
  .me h3 { font-family: var(--font-me); font-weight: 700; font-size: 2.4rem; letter-spacing: 0.12em; text-transform: uppercase; text-shadow: 0 0 16px rgba(79, 195, 255, 0.6); }
  .me .studio { color: #4fc3ff; font-family: var(--font-me); }
  .me .why { font-family: var(--font-body); }

  /* Persona 5 card: red, black slashes, tilted */
  .p5 {
    background:
      repeating-linear-gradient(-55deg, transparent 0 38px, rgba(0, 0, 0, 0.18) 38px 46px),
      var(--p-red);
    transform: rotate(-2deg);
    clip-path: polygon(0 4%, 100% 0, 96% 100%, 3% 96%);
  }
  .p5:hover { transform: rotate(-2deg) translateY(-6px); }
  .p5 h3 {
    font-family: var(--font-p);
    font-size: 3rem;
    text-transform: uppercase;
    background: var(--p-black);
    align-self: flex-start;
    padding: 0.1rem 0.6rem;
    transform: skewX(-10deg);
  }
  .p5 .studio { font-family: var(--font-p); letter-spacing: 0.1em; }
  .p5 .slot { color: var(--p-black); opacity: 0.5; }

  /* Locked slot */
  .locked {
    border: 2px dashed rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.02);
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .locked h3 { font-family: var(--font-p); font-size: 4rem; opacity: 0.4; }
  .locked .why { opacity: 0.5; }

  @media (max-width: 900px) { .games { grid-template-columns: 1fr; } }
</style>
