---
import { missions } from '../data/profile';
import Planet from './Planet.astro';
---

<section id="missions">
  <div class="wrap">
    <h2 class="p-heading">Galaxy Map</h2>
    <p class="me-label">Select a system to view the mission log</p>

    <div class="layout reveal">
      <div class="map holo" role="tablist" aria-label="Internships">
        <svg class="orbits" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <ellipse cx="50" cy="50" rx="45" ry="38" />
          <ellipse cx="50" cy="50" rx="30" ry="25" />
          <ellipse cx="50" cy="50" rx="15" ry="12" />
        </svg>
        {missions.map((m, i) => (
          <button
            class={`node ${m.status === 'ACTIVE' ? 'active-mission' : ''}`}
            style={`left:${m.x}%;top:${m.y}%`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`m-${m.id}`}
            data-id={m.id}
          >
            <Planet id={`n-${m.id}`} color={m.color} rings={m.rings} size={44} class="dot" />
            <span class="label">{m.system}</span>
          </button>
        ))}
      </div>

      <div class="logs">
        {missions.map((m, i) => (
          <article id={`m-${m.id}`} class="holo log" role="tabpanel" hidden={i !== 0}>
            <Planet id={`l-${m.id}`} color={m.color} rings={m.rings} size={150} class="hero-planet" />
            <p class="me-label">Mission log · <span class={m.status === 'ACTIVE' ? 'live' : ''}>{m.status}</span></p>
            <h3>{m.system}</h3>
            <p class="role">{m.role}</p>
            {(m.when || m.where) && (
              <p class="meta">{[m.when, m.where].filter(Boolean).join('  ·  ')}</p>
            )}
            <p class="brief">{m.brief || 'Mission details classified. Ask me about it.'}</p>
            {m.story && (
              <div class="story">
                <p class="story-label">The story</p>
                <p>{m.story}</p>
              </div>
            )}
            {m.details.length > 0 && (
              <ul class="details">
                {m.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
            {m.tools.length > 0 && (
              <ul class="tools">
                {m.tools.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const nodes = document.querySelectorAll<HTMLButtonElement>('#missions .node');
  nodes.forEach((node) =>
    node.addEventListener('click', () => {
      nodes.forEach((n) => n.setAttribute('aria-selected', String(n === node)));
      document.querySelectorAll<HTMLElement>('#missions .log').forEach((log) => {
        log.hidden = log.id !== `m-${node.dataset.id}`;
      });
    })
  );
</script>

<style>
  .layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }

  .map { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .orbits { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbits ellipse { fill: none; stroke: var(--holo); stroke-width: 0.15; opacity: 0.35; stroke-dasharray: 1 1; }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    color: var(--p-white);
    cursor: pointer;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    z-index: 1;
    font-family: var(--font-me);
  }
  .node :global(.dot) { transition: transform 0.2s; filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.6)); }
  .active-mission :global(.dot) { animation: bob 2.4s ease-in-out infinite; }
  .label {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    white-space: nowrap;
    padding: 0.1rem 0.5rem;
  }
  .node:hover :global(.dot), .node:focus-visible :global(.dot) { transform: scale(1.25); }
  .node[aria-selected='true'] :global(.dot) { transform: scale(1.45); }
  .node[aria-selected='true'] .label {
    background: var(--p-red);
    transform: skewX(-10deg);
    font-family: var(--font-p);
    letter-spacing: 0.05em;
    font-size: 1rem;
  }

  .log { padding: 2rem; min-height: 100%; position: relative; }
  .log :global(.hero-planet) { position: absolute; top: -10px; right: -10px; opacity: 0.9; pointer-events: none; }
  .story { border-left: 3px solid var(--p-red); padding: 0.2rem 0 0.2rem 1rem; margin: 0 0 1.25rem; font-family: var(--font-body); font-size: 0.95rem; }
  .story p { margin: 0; }
  .story .story-label { font-family: var(--font-p); text-transform: uppercase; color: var(--p-red); font-size: 1rem; margin-bottom: 0.3rem; }
  h3 { position: relative; max-width: 75%; font-family: var(--font-me); font-size: 2.2rem; letter-spacing: 0.06em; margin: 0.5rem 0 0; }
  .role { font-weight: 700; font-size: 1.15rem; margin: 0.2rem 0; color: var(--holo); }
  .meta { opacity: 0.65; font-size: 0.9rem; margin: 0; }
  .brief { font-family: var(--font-body); font-size: 1.05rem; margin: 1.25rem 0; }
  .live { color: #4cff7a; }
  .details { font-family: var(--font-body); font-size: 0.95rem; margin: 0 0 1.25rem; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  .details li { padding-left: 1.2rem; position: relative; }
  .details li::before { content: '▸'; position: absolute; left: 0; color: var(--holo); }
  .tools { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tools li {
    border: 1px solid var(--holo);
    padding: 0.15rem 0.6rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  @keyframes bob { 50% { translate: 0 -5px; } }

  @media (max-width: 800px) {
    .layout { grid-template-columns: 1fr; }
    .label { font-size: 0.7rem; }
  }
</style>
